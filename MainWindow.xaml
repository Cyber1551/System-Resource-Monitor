<Window x:Class="System_Resource_Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:System_Resource_Monitor"
        xmlns:views="clr-namespace:System_Resource_Monitor.Views"
        xmlns:vm="clr-namespace:System_Resource_Monitor.ViewModels"
        mc:Ignorable="d"
        Title="System Resource Monitor"
        Height="720" Width="1180"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header KPI strip: CPU / MEMORY / DISK. -->
        <Border Grid.Row="0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <UniformGrid Columns="3">
                <Border Style="{StaticResource KpiTile}" DataContext="{Binding Cpu}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="CPU"/>
                        <TextBlock Style="{StaticResource KpiNumber}" Margin="0,2,0,0"
                                   Text="{Binding TotalPercent, StringFormat={}{0:F1}%}"/>
                        <TextBlock Style="{StaticResource KpiSubtext}" Margin="0,2,0,0"
                                   Text="{Binding Cores.Count, StringFormat={}{0} LOGICAL CORES}"/>
                    </StackPanel>
                </Border>

                <views:MemoryView DataContext="{Binding Memory}"/>

                <views:DiskView DataContext="{Binding Disk}"/>
            </UniformGrid>
        </Border>

        <!-- Body: left column has chart over per-core matrix; right column is process list. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <views:HistoryChartView Grid.Row="0" DataContext="{Binding History}"/>
                <Border Grid.Row="1" Style="{StaticResource Rule}" Height="1"/>
                <views:CpuView Grid.Row="2" DataContext="{Binding Cpu}"/>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource Rule}" Width="1"/>

            <views:ProcessListView Grid.Column="2" DataContext="{Binding Processes}"/>
        </Grid>

        <!-- Footer: terminal-style status bar with host, uptime, last sample time. -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,6">
            <TextBlock Style="{StaticResource KpiSubtext}" Text="{Binding StatusText}"/>
        </Border>
    </Grid>
</Window>
