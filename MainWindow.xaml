<Window x:Class="System_Resource_Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:System_Resource_Monitor"
        xmlns:views="clr-namespace:System_Resource_Monitor.Views"
        mc:Ignorable="d"
        Title="System Resource Monitor"
        Height="720" Width="1180"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid Margin="8">
        <views:CpuView DataContext="{Binding Cpu}"/>
    </Grid>
</Window>
